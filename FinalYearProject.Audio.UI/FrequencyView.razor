@using System.Globalization

<div class="main-body">
    <div class="visualizer-main">
        <svg width="@Width" height="@(1.2 * Height)">

            <g transform="translate(@Padding,@Padding)">
                <polyline fill="none"
                          stroke="@LineColor"
                          stroke-width="@LineWidth"
                          points="@_points" />
            </g>

            <g transform="translate(@Padding,@Padding)">
                <!-- Frequency labels -->
                @foreach (var label in _labels)
                {
                    <g>
                        <text x="@label.X" y="@Height" font-size="10" text-anchor="middle">
                            @label.Text
                        </text>
                    </g>
                }
            </g>
        </svg>
    </div>

    <VisualizerToolbar OnStart="Start"
                       OnStop="Stop"
                       Onreset="Reset" />

</div>

