@using FinalYearProject.Audio.Helpers
@using FinalYearProject.Shared.Helpers

<div class="main-body">
    @if (_points.Count != 0)
    {
        <svg width="@Width" height="@(2 * Height)">
            <polyline fill="@GetFill()"
                      stroke="@LineColor"
                      stroke-width="@LineWidth"
                      points="@BuildPositivePoints()" />

            <polyline fill="@GetFill()"
                      stroke="@LineColor"
                      stroke-width="@LineWidth"
                      points="@BuildNegativePoints()" />
        </svg>
    }
</div>