@page "/audio-view"


<h2>Time Domain (Continuous) View</h2>
<TimeDomainView FileName="eminor-test.wav"
                FolderName="AudioFiles"
                LineColor="red"
                LineWidth="3" />

<h2>Wave Form View</h2>
<WaveFormView FileName="eminor-test.wav"
              FolderName="AudioFiles"
              LineColor="red"
              Fill="true"
              LineWidth="1"
              Resolution="2048" />


<h2>Frequency View (Spectogram)</h2>
<FrequencyView FileName="eminor-test.wav"
               FolderName="AudioFiles"
               LineColor="red"
               LineWidth="1"
               Height="200"
               Padding="40"
               Resolution="4096"/>