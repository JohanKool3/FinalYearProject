@page "/audio-view"
@using FinalYearProject.Audio.UI.Components

<div class="analysis-views">
    <div>
        <h2>Time Domain (Continuous) View</h2>
        <TimeDomainView LineColor="red"
                        LineWidth="3"
                        Width="400"
                        Height="100" />
    </div>

    <div>
        <h2>Frequency View (Spectogram)</h2>
        <FrequencyView LineColor="red"
                       LineWidth="1"
                       Height="167"
                       Width="400"
                       Padding="40"
                       Resolution="4096" />
    </div>

    <div>
        <h2>Waveform View (Realtime) </h2>
        <WaveformBuilder Height="200"
                         Width="400"
                         Resolution="4096"
                         LineColor="red"
                         LineWidth="1" />

    </div>
</div>

<h2>Monophonic Pitch Detector</h2>
<MonoPitchDetection />

<VisualizerToolbar OnStart="AudioService.Start"
                   OnStop="AudioService.Stop"
                   OnReset="AudioService.Reset" />

