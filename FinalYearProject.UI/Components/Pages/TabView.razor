@page "/tabview"
@page "/tabview/{PieceId:guid}"
@using FinalYearProject.UI.Components.InterfaceElements
@using FinalYearProject.UI.Components.InterfaceElements.Recording

@if (!TabIsLoaded())
{
    <div class="tab-view-loading-icon">
        <LoadingIcon Height="200"
                     Width="200" />
    </div>
}
else
{
    <TabWidget />
    <AudioFileManager PieceId="PieceId" />
}



