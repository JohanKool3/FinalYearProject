@page "/results/{PieceId:guid}"
@using FinalYearProject.UI.Components.InterfaceElements
@using FinalYearProject.UI.Components.InterfaceElements.Recording.Results

@if (!DataLoaded())
{
    <div class="loading-icon">
        <LoadingIcon Height="200"
                     Width="200" />
    </div>
}
else
{
    <div class="results-view">
        <ResultsGraphic Value="Results.NoteAccuracy"
                        Size="200"
                        StrokeWidth="25"
                        Title="Note Accuracy" />
    </div>

}