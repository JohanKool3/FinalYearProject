@page "/results/{PieceId:guid}"
@using FinalYearProject.UI.Components.InterfaceElements

@if (!DataLoaded())
{
    <div class="loading-icon">
        <LoadingIcon Height="200"
                     Width="200" />
    </div>
}
else
{
    <h1>Performance Results for: @displayService.Title</h1>

    <div class="results-area">
        <div class="result-section">
            <span class="no-wrap">Note Accuracy</span>
            <StaticProgressBar Value="_accuracy" />
            <span class="no-wrap">@_accuracy%</span>
        </div>
    </div>
}