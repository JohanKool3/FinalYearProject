<div class="results-graphic">
    <div class="title">
        <h2>@Title</h2>
    </div>


    <svg width="@Size" height="@Size" viewBox="0 0 @Size @Size">
        <!-- Background ring -->
        <circle cx="@GetCenterCoordinate()"
                cy="@GetCenterCoordinate()"
                r="@Radius"
                stroke="#e0e0e0"
                stroke-width="@StrokeWidth"
                fill="none" />

        <!-- Progress ring -->
        <circle cx="@GetCenterCoordinate()"
                cy="@GetCenterCoordinate()"
                r="@Radius"
                stroke="green"
                stroke-width="@StrokeWidth"
                fill="none"
                stroke-linecap="round"
                stroke-dasharray="@Circumference"
                stroke-dashoffset="@((1 - ClampedValue) * Circumference)"
                transform="rotate(-90 @Size/2 @Size/2)" />

        @* Percentage Readout *@
        <text x="50%"
              y="50%"
              dominant-baseline="middle"
              text-anchor="middle"
              font-size="20"
              font-weight="bold"
              fill="#333">
            @(Math.Round(ClampedValue * 100))%
        </text>
    </svg>
</div>