
<div class="waveform-view">
    <svg width="@Width" height="@Height" viewBox="0 0 @Width @Height" preserveAspectRatio="none">
        @for (int i = 0; i < WaveForm.Length; i++)
        {
            var height = WaveForm[i] * Height;
            var y = (Height - height) / 2;
            var isPlayed = i < Progress * WaveForm.Length;

            <rect x="@i"
                  y="@y"
                  width="@GetSampleWidth()"
                  height="@height"
                  fill="@(isPlayed ? "green" : "black")" />
        }
    </svg>

</div>