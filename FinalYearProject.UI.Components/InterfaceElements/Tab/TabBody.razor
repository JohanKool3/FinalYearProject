@using FinalYearProject.UI.Components.InterfaceElements.MainBar

@* Purely used for Displaying Tablature Information *@
<div class="tab-body">

    @if (!IsTabLoaded())
    {
        <p>No Tab Loaded</p>
    }
    else
    {
        <div class="tab-bars-container">

            @* TODO: Place Tuning at the start of the piece*@
            <Tuning />

            @foreach (var (bar, index) in (GetCurrentTab()?.Bars ?? [])
                    .Select((bar, index) => (bar, index)))
            {
                <FullBar BarNumber="index + 1"
                         BarInformation="bar"
                         ShowTimeSignature="RenderTimeSignatureForBar(index - 1, index)"
                         ShowBpmMarking="RenderBpmForBar(index - 1, index)" />
            }
        </div>
    }
</div>

