@* The Title of the Tab *@
<div class="header-container">
    <h1 class="tab-header">@_title</h1>

    @* Who Wrote the Tab *@
    <div>
        <h3 class="tab-subheader">@_author</h3>

        @if (_tabDescription != string.Empty)
        {
            <p class="tab-description">@_tabDescription</p>
        }
    </div>
</div>

