@using FinalYearProject.UI.Components.InterfaceElements.TopBar

<svg height="@_height" width="@Width">
    <g>

        @if (_debugMode)
        {
            <rect x="0" y="0" width="@Width" height="@_height" fill="green" opacity="0.1" stroke="black" stroke-width="2" />
        }
        @* Bar Number Representation *@
        <BarNumber BarNumberValue="BarNumber"
                   XPosition="0"
                   YPosition="GetYPosition(3)" />

        @if (ShowBpmMarking)
        {
            <BpmMarking BarInformation="BarInformation"
                        XPosition="_barNumberFontSize"
                        YPosition="GetYPosition(3)" />
        }

        @* Chord Display *@
        <Chords BarInformation="BarInformation"
                XPosition="0"
                YPosition="GetYPosition(2)"
                Width="Width"
                XOffset="XOffset"
                RowNumber="1" />
    </g>
</svg>
