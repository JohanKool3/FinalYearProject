@using FinalYearProject.Shared.Models.TabRepresentation
@using FinalYearProject.UI.Components.InterfaceElements
@using FinalYearProject.UI.Components.InterfaceElements.Bar
@using FinalYearProject.UI.Components.Models
<div class="tab-view">

    @if (!IsTabLoaded())
    {
        <p>No Tab Loaded</p>
    }
    else
    {
        <div class="tab-bars-container">
            @foreach (var (bar, index) in (GetCurrentTab()?.Bars ?? [])
                    .Select((bar, index) => (bar, index)))
            {
                <TabBar BarNumber="index + 1"
                        BarInformation="bar"
                        ShowTimeSignature="RenderTimeSignatureForBar(index - 1, index)"
                        ShowTuning="RenderTuningForBar(index)"/>
            }
        </div>
    }
</div>

