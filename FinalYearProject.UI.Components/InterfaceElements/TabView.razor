@using FinalYearProject.Shared.Models.TabRepresentation
@using FinalYearProject.UI.Components.InterfaceElements
@using FinalYearProject.UI.Components.InterfaceElements.Bar
@using FinalYearProject.UI.Components.Models
<div class="tab-view">

    @if (!IsTabLoaded())
    {
        <p>No Tab Loaded</p>
    }
    else
    {
        <div class="tab-bars-container">

            @{
                // Simulate Notes to be Rendered
                var notes = new List<NoteDisplayInformation>
                {
                new()
                {
                BarPercentage = 0,
                FretNumber = 5,
                StringNumber = 6
                },
                new()
                {
                BarPercentage = 16,
                FretNumber = 5,
                StringNumber = 5,
                },

                new()
                {
                BarPercentage = 32,
                FretNumber = 5,
                StringNumber = 4
                },
                new()
                {
                BarPercentage = 48,
                FretNumber = 5,
                StringNumber = 3
                },
                new()
                {
                BarPercentage = 64,
                FretNumber = 5,
                StringNumber = 2
                },
                new(){
                BarPercentage = 80,
                FretNumber = 5,
                StringNumber = 1
                }
                };
            }

            @* Simulate Rendering 10 Bars *@
            @for (var i = 0; i < 10; i++)
            {

                var width = RepresentationService.GetBarWidth(notes);
                var height = RepresentationService.GetBarHeight();

                <svg width="@width" height="@height">

                    @* Information Placed over the bar *@
                    <TopBarInformation BarNumber="@(i + 1)" />

                    @* Renders the String Representation *@
                    <Strings Notes="notes" />

                    @* Renders the Notes on the String *@
                    <Notes NotesToDisplay="notes" />
                </svg>
            }


        </div>
    }
</div>

