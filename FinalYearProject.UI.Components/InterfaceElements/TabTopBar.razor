@using FinalYearProject.UI.Components.InterfaceElements.TopBar

<svg height="@_height" width="@_width">
    <g>
        @* Bar Number Representation *@
        <BarNumber BarNumberValue="BarNumber" />

        @if (ShowBpmMarking)
        {
            <svg>
                @* BPM Marking Representation *@
                <text x="@(_leftPadding + _barNumberFontSize)"
                      y="@_topPadding"
                      font-family="Arial"
                      font-style="oblique"
                      font-size="@_barNumberFontSize"
                      fill="black">@BarInformation.Bpm BPM</text>
            </svg>
        }
        )
    </g>
</svg>
