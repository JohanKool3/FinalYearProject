@* Component for Rendering Guitar Strings *@
@using FinalYearProject.Shared.Models.TabRepresentation
<g>
    @for (int i = 0; i < _stringAmount; i++)
    {
        // Draw each string line
        <line x1="0"
              y1="@(i* _stringSpacing + _topPadding)"
              x2="@(Width)"
              y2="@((i * _stringSpacing) + _topPadding)"
              stroke="black" stroke-width="1" />
    }
</g>

@* Show the End of the Bar *@
<BarLine StartYPosition="_topPadding"
         EndYPosition="@(5 * _stringSpacing + _topPadding)"
         XPosition="Width" />

         
