@using FinalYearProject.Shared.Enums
@using FinalYearProject.Shared.Models.UI.Bar

<g>
    @if (_debugMode)
    {
        @* Indicate Bounding Box for this Note Group *@
        <rect x="@XPosition" y="4" width="@Width" height="@(_barHeight - 8)" fill="none" opacity="0.5" stroke="black" stroke-width="4" />
    }

    @foreach (var note in NoteGroupInformation.Notes)
    {
        @if (note.NoteType == NoteType.Grace)
        {
            <GraceNote Note="note"
                       XPosition="GetNoteXPosition(note)"
                       YPosition="GetNoteYPosition(note)"
                       Size="(2 * _stringSpacing) / 3" />
        }
        else
        {
        
            <NormalNote Note="note"
                        XPosition="GetNoteXPosition(note)"
                        YPosition="GetNoteYPosition(note)"
                        Size="_stringSpacing" />
        }
    }
</g>

