
<g>
    @if (_debugMode)
    {
        @* Indicate Bounding Box for this Note Group *@
        <rect x="@(_xOffset-4)" y="4" width="@(_groupWidth + 4)" height="@(_barHeight - 8)" fill="none" opacity="0.5" stroke="black" stroke-width="4" />
    }

    @foreach (var note in NoteGroupInformation.Notes)
    {
        @if (note.NoteType == NoteType.Normal)
        {
            <NormalNote Note="note"
                        XPosition="GetNoteXPosition(note)"
                        YPosition="GetNoteYPosition(note)"
                        Size="_stringSpacing" />
        }
        else if (note.NoteType == NoteType.Grace)
        {
            <GraceNote Note="note"
                       XPosition="GetNoteXPosition(note)"
                       YPosition="GetNoteYPosition(note)"
                       Size="(2 * _stringSpacing) / 3" />
        }
        // TODO: Implement other note types here
    }
</g>

