@using FinalYearProject.UI.Components.InterfaceElements.TabBrowser.Elements
@using Microsoft.AspNetCore.Components.Forms
<div class="tab-browser" style="width:@($"{Width}px"); height:@($"{Height}px");">
    <div class="tab-browser-title">
        <h1>Tab Browser</h1>
    </div>

    <div class="tab-browser-search-bar">
        <span>Search: </span>
        <input @bind-value="UserSearch" />
        <button>Enter</button>
    </div>

    @if (!DataLoaded)
    {
        // Display the Loading Icon
        <div class="loading-icon">
            <LoadingIcon Height="64"
                         Width="64" />

        </div>
    }
    else
    {
        foreach (var dataItem in localData)
        {
            <BrowserItem Name="@dataItem.PieceName"
                         OnClick="() => NavigateToPiece(dataItem.Id)" />
        }
    }
</div>