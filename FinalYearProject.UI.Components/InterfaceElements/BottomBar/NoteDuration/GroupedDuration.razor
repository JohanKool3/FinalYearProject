<line x1="@XPosition"
      y1="@YPosition"
      x2="@XPosition"
      y2="@_noteHeight"
      stroke="black" stroke-width="2" />

@* Horizontal Line Connecting Grouped Notes *@
<line x1="@XPosition"
      y1="@_noteHeight"
      x2="@NextNoteXPosition"
      y2="@_noteHeight"
      stroke="black" stroke-width="2" />