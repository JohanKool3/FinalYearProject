@using FinalYearProject.Shared.Enums
@using FinalYearProject.Shared.Models.UI.Bar
@using FinalYearProject.UI.Components.InterfaceElements.BottomBar.NoteDuration



@for (int index = 0; index < NoteGroupInformation.Notes.Count; index++)
{
    var note = NoteGroupInformation.Notes[index];

    // Handle Grouped Notes
    if (note.Properties.IsGrouped)
    {
        // Look ahead
        if (index < GroupLength - 1)
        {
            // Check the next Index
            var nextNote = NoteGroupInformation.Notes[index + 1];

            if (nextNote.Properties.IsGrouped)
            {
                // Need to render Grouped for this
                <GroupedDuration XPosition="@GetNoteXPosition(note)"
                                 NextNoteXPosition="@GetNoteXPosition(nextNote)"
                                 YPosition="0" />
            }
            else
            {
                <SeparateDuration XPosition="@GetNoteXPosition(note)"
                                  YPosition="0" />
            }
        }
        else
        {
            <SeparateDuration XPosition="@GetNoteXPosition(note)"
                              YPosition="0" />
        }
    }
    // Handle Separate Notes
    else
    {
        @if (note.Properties.Type == NoteType.Grace)
        {
            @* Indicate a grace note *@
            <GraceNoteDuration XPosition="@GetNoteXPosition(note)"
                               YPosition="0" />
        }
        else
        {
            <SeparateDuration XPosition="@GetNoteXPosition(note)"
                              YPosition="0" />
        }
    }
}
