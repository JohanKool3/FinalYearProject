@using FinalYearProject.Shared.Enums
@using FinalYearProject.UI.Components.InterfaceElements.BottomBar.NoteDuration

@foreach (var note in NoteGroupInformation.Notes)
{
    // TODO: Detect when a note is grouped
    @if (note.Properties.Type == NoteType.Grace)
    {
        @* Indicate a grace note *@
        <GraceNoteDuration XPosition="@GetNoteXPosition(note)"
                           YPosition="0" />
    }
    else
    {
        <SeparateDuration XPosition="@GetNoteXPosition(note)"
                          YPosition="0" />
    }
}

