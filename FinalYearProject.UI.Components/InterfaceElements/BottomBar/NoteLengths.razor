@using FinalYearProject.UI.Components.InterfaceElements.BottomBar.NoteDuration
@* Here will be the note lengths *@

@foreach (var note in BarInformation.Notes)
{
    @if (note.NoteType == NoteType.Grace)
    {
        @* Indicate a grace note *@
        <GraceNoteDuration XPosition="@GetNoteXPosition(note)" />
    }
    else
    {
        <CrotchetDuration XPosition="@GetNoteXPosition(note)" />
    }
}