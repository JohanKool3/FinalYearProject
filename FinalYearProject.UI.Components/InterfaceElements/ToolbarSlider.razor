@using FinalYearProject.UI.Components.InterfaceElements.ToolbarWidgets

<ToolbarWidgetBase ToolTipMessage="@Tooltip">
    <div class="slider-wrapper">

        <div class="slider-trigger" @onclick="Toggle">
            @ChildContent
        </div>
        @if (IsOpen)
        {
            <div class="slider-section">
                <div class="slider-popup @IsEnabled()"
                     @onmouseleave="Toggle">
                    <span class="slider-title">@Title</span>
                    <input type="range"
                           min="0"
                           max="100"
                           value="@Value"
                           @oninput="OnInputAsync" />

                    <span class="suffix">@Value%</span>
                </div>

            </div>
        }
    </div>
</ToolbarWidgetBase>
