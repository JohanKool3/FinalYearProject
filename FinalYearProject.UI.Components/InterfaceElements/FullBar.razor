@using FinalYearProject.UI.Components.Models

<svg width="@_barWidth" height="@_totalComponentHeight">

    @* Header of the bar *@
    <g transform="translate(0, 0)">
        <BarTopSection BarNumber="@BarNumber"
                       ShowBpmMarking="ShowBpmMarking"
                       BarInformation="BarInformation"
                       Width="_barWidth"
                       XOffset="GetPrebarOffset()" />

    </g>

    @* Main Body *@
    <g transform="translate(0, @(_topBarHeight))">

        <BarMainBody ShowTimeSignature="ShowTimeSignature"
                     BarInformation="BarInformation" />
    </g>>

    @* Footer Section *@
    <g transform="translate(0, @GetBottomBarYOffset())">
        <BarBottomSection Width="@_barWidth"
                          BarInformation="BarInformation" />
    </g>
    <PlaybackIndicator 
        BarNumber="@BarNumber"
        XPosition="0"
        YPosition="GetPlaybackIndicatorYPosition()"
        BarTimeSignature="BarInformation.TimeSignature"
        ParentBarWidth="@_barWidth"/>
</svg>
    
