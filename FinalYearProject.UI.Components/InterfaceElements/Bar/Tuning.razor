@* Shows the Tuning for the given tab *@
<svg height="@_height" width="@_width">
    <g>
        @for (int stringNumber = 1; stringNumber <= _stringAmount; stringNumber++)
        {
            @* Remind the compiler that it is dealing with svg *@
            <svg>
                <text x="0"
                      y="@GetAdjustedYPosition(stringNumber)"
                      dominant-baseline="middle"
                      fill="black" font-size="@_fontSize" font-family="Arial">
                  @GetStringTuning(stringNumber)
                  </text>
            </svg>
        }
    </g>
</svg>
