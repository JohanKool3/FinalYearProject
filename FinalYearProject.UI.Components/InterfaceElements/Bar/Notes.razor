<g>
    @foreach (var note in NotesToDisplay)
    {
        <svg>
            @* Note Background *@
            <circle cx="@(GetNoteXPosition(note))"
                    cy="@GetNoteYPosition(note)"
                    r="@(_stringSpacing / 2)"
                    fill="white" />

            @* Note Fret Number *@
            <text x="@GetNoteXPosition(note)"
                  y="@(GetNoteYPosition(note) + (_stringSpacing * 0.1))"
                  font-family="Arial"
                  font-size="@(_stringSpacing)"
                  text-anchor="middle"
                  dominant-baseline="middle"
                  fill="black">
                @note.FretNumber
            </text>

        </svg>
    }
</g>

