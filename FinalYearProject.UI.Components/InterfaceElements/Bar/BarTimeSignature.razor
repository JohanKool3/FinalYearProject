@using FinalYearProject.Shared.Models.TabRepresentation

@* Draw Lines for the Strings to give the feeling that the signature is part
of the bar *@
<g>
    @for (int i = 0; i < _stringAmount; i++)
    {
        <line x1="0"
              y1="@(i* _stringSpacing + _topPadding)"
              x2="@(_width)"
              y2="@((i * _stringSpacing) + _topPadding)"
              stroke="black" stroke-width="1" />
    }
</g>

@* Render the Time Signature Numbers *@
<g>

    <!-- Top number (numerator) -->
    <text x="@GetAdjustedXPosition()"
          y="@GetAdjustedYPosition()"
          dominant-baseline="middle"
          font-size="@FontSize">
        @TimeSignature.BeatsPerMeasure
    </text>

    <!-- Bottom number (denominator) -->
    <text x="@GetAdjustedXPosition()"
          y="@(GetAdjustedYPosition() + FontSize)"
          dominant-baseline="middle"
          font-size="@FontSize">
        @TimeSignature.BeatUnit
    </text>

</g>


