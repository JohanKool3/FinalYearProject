@using FinalYearProject.UI.Components.InterfaceElements.ToolbarWidgets

@* This is the main widget that will display Guitar Tab *@

<div class="tab-widget">
    @* Top Toolbar *@

    <div class="tab-view">
        <TabHeader />
        <TabBody />
    </div>

    @* Bottom Toolbar *@
    <div class="toolbar">
        <TabToolbar>
            <PlayButton NotifyParentOfChange="PlaybackStateChanged" />

            <PauseButton NotifyParentOfChange="PlaybackStateChanged" />

            <BpmWidget NotifyParentOfChange="PlaybackStateChanged" />
        </TabToolbar>
    </div>
</div>
@code {
    private Task PlaybackStateChanged()
        => InvokeAsync(StateHasChanged);
}