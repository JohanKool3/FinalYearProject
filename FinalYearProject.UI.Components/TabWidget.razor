@* This is the main widget that will display Guitar Tab *@

<div class="tab-widget">
    @* Top Toolbar *@
    <div class="toolbar">
        <TabToolbar>
            <label class="toolbar-widget">Guitar Tab Top Toolbar</label>
            <label class="toolbar-widget">This will be a widget</label>
        </TabToolbar>
    </div>

    <div class="tab-view">
        <TabView />
    </div>

    @* Bottom Toolbar *@
    <div class="toolbar">
        <TabToolbar>
            <PlayButton />
            <PauseButton />
            <BpmWidget />
        </TabToolbar>
    </div>
</div>