@* This is the main widget that will display Guitar Tab *@

<div class="tab-widget">
    @* Top Toolbar *@
    <div class="toolbar">
        <TabToolbar>
        </TabToolbar>
    </div>

    <div class="tab-view">
        <TabView />
    </div>

    @* Bottom Toolbar *@
    <div class="toolbar">
        <TabToolbar>
            <PlayButton 
                NotifyParentOfChange="PlaybackStateChanged" />

            <PauseButton 
                NotifyParentOfChange="PlaybackStateChanged" />

            <BpmWidget 
                NotifyParentOfChange="PlaybackStateChanged" />
        </TabToolbar>
    </div>
</div>
@code {
    private Task PlaybackStateChanged()
        => InvokeAsync(StateHasChanged);
}