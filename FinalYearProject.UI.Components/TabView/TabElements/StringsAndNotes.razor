@using FinalYearProject.Shared.Models.TabRepresentation
<g>
    @for (int i = 0; i < 6; i++)
    {
        // Draw each string line
        <line x1="@StartX"
              y1="@(StartY + (i * StringSpacing) + TopPadding)"
              x2="@(StartX + Width)"
              y2="@((i * StringSpacing) + TopPadding)"
              stroke="black" stroke-width="1" />
    }

    @foreach(var note in Bar.Notes)
    {
        // Draw each note as a circle on the appropriate string line
        <circle cx="@GetNoteXCoordinate(note)"
                cy="@GetNoteYCoordinate(note)"
                r="@(NoteSize/2)"
                fill="black" />
    }
)
</g>

<BarLine 
    StartYPosition="TopPadding"
    EndYPosition="(5 * StringSpacing) + TopPadding"
    XPosition="Width"/>
