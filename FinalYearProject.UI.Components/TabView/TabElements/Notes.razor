<g>
    @foreach (var note in NotesToDisplay)
    {
        <svg>
            <circle cx="@(_leftPadding + GetNotePosition(note))"
                    cy="@(_topPadding - (NoteCutoutRadius / 2))"
                    r="@NoteCutoutRadius"
                    fill="white" />

            <text x="@(_leftPadding
                  + GetNotePosition(note)
                  - NoteCutoutRadius / 2)"
              y="@_topPadding"
              font-family="Arial"
              font-size="12"
              fill="black">
            @note.FretNumber
        </text>

        </svg>
        }
</g>

