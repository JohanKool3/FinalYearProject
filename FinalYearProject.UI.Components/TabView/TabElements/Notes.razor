<g>
    @foreach (var note in NotesToDisplay)
    {
        <svg>
            @* <circle cx="@(_leftPadding + GetNoteXPosition(note))"
                    cy="@GetNoteYPosition(note)"
                    r="@NoteCutoutRadius"
                    fill="white" /> *@

            <text x="@GetNoteXPosition(note)"
                  y="@(GetNoteYPosition(note))"
                  font-family="Arial"
                  font-size="@(_stringSpacing)"
                  text-anchor="middle"
                  dominant-baseline="middle"
                  fill="black">
                @note.FretNumber
            </text>

        </svg>
    }
</g>

