@using FinalYearProject.Shared.Models.TabRepresentation
@using FinalYearProject.UI.Components.TabView.TabElements
<div class="tab-view">

    @if (!IsTabLoaded())
    {
        <p>No Tab Loaded</p>
    }
    else
    {
        @* Iterate over each bar and render it *@
        <div class="tab-bars-container">
            <p>Tab Has Been Loaded</p>

            <svg width="100%" height="100%">
                @{
                    TimeSignature? currentTimeSignature = null;

                    foreach (var bar in GetCurrentTab()?.Bars ?? [])
                    {
                        var newTimeSignature = bar.TimeSignature;
                        var timeSignatureSpacing = 0;

                        var previousBarX = 0;

                        @if (currentTimeSignature is null || newTimeSignature != currentTimeSignature)
                        {
                            // Render the new Time Signature
                            currentTimeSignature = newTimeSignature;

                            <BarTimeSignature TimeSignature="currentTimeSignature"
                                              XPosition="0"
                                              YPosition="17" />

                            timeSignatureSpacing = 12;
                        }

                        // Render the Strings and the Notes on the Strings
                        <StringsAndNotes TopPadding="2"
                                         Bar="bar"
                                         TimeSignatureSpacing="timeSignatureSpacing" />
                    }
                }
            </svg>

        </div>
    }
</div>

