@using FinalYearProject.Shared.Models.TabRepresentation
@using FinalYearProject.UI.Components.Helpers
@using FinalYearProject.UI.Components.TabView.TabElements
<div class="tab-view">

    @if (!IsTabLoaded())
    {
        <p>No Tab Loaded</p>
    }
    else
    {
        <div class="tab-bars-container">

            @* Simulate Rendering 10 Bars *@
            @for (var i = 0; i < 10; i++)
            {
                <svg width="300" height="75">

                    <TopBarInformation 
                        BarNumber="@(i + 1)" />

                    @* Renders the String Representation *@
                    <Strings Height="75"
                             Width="300"
                             TopPadding="15" />
                </svg>
            }


        </div>
    }
</div>

