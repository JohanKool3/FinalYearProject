@using FinalYearProject.Shared.Models.TabRepresentation
<div class="tab-view">

    @if (!IsTabLoaded())
    {
        <p>No Tab Loaded</p>
    }
    else
    {
        @* Iterate over each bar and render it *@
        <div class="tab-bars-container">
            <p>Tab Has Been Loaded</p>

            @foreach (var bar in GetCurrentTab()?.Bars ?? [])
            {
                <p>@bar.BarNumber</p>
            }

        </div>
    }
</div>

