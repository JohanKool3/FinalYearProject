@* Represents a single bar *@

<svg class="tabbar-svg" width="@(Width + GetTimeSignatureAllocatedSpace())" height="@Height" viewBox="0 0 @(Width + GetTimeSignatureAllocatedSpace()) @Height" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Guitar tab bar">

    <!-- Outer bar background -->
    <rect x="0" y="0" width="@(Width + GetTimeSignatureAllocatedSpace())" height="@Height"
          fill="#fbfbfb" stroke="@BarStroke" stroke-width="2" />

    <!-- Inner area border (optional, visually the 'bar' area) -->
    <rect x="@StringStroke" y="@StringStroke" width="@_innerWidth" height="@_innerHeight"
          fill="none" stroke="transparent" />

    @if (ShowTimeSignature)
    {
        <!-- Time signature area with stacked format -->
        <g class="time-signature" text-anchor="middle" font-family="serif" font-weight="bold" fill="#111">
            <!-- Top number (numerator) -->
            <text x="@(GetTimeSignatureAllocatedSpace() / 2)"
                  y="@(Height / 2 - 12)"
                  dominant-baseline="middle"
                  font-size="24">
                @Bar.TimeSignature.BeatsPerMeasure
            </text>

            <!-- Horizontal line -->
            <line x1="@(GetTimeSignatureAllocatedSpace() / 2 - 8)"
                  y1="@(Height / 2)"
                  x2="@(GetTimeSignatureAllocatedSpace() / 2 + 8)"
                  y2="@(Height / 2)"
                  stroke="#111"
                  stroke-width="2" />

            <!-- Bottom number (denominator) -->
            <text x="@(GetTimeSignatureAllocatedSpace() / 2)"
                  y="@(Height / 2 + 18)"
                  dominant-baseline="middle"
                  font-size="24">
                @Bar.TimeSignature.BeatUnit
            </text>
        </g>
    }

    <!-- Strings (lines) -->
    @for (int i = 0; i < StringCount; i++)
    {
        var y = YForString(i);
        <line x1="@(GetTimeSignatureAllocatedSpace() + StringStroke)" y1="@y" x2="@_innerWidth" y2="@y"
              stroke="@StringColor" stroke-width="@StringStroke" stroke-linecap="round" />
    }

    <!-- Bar Lines -->
    <line x1="@(GetTimeSignatureAllocatedSpace() + StringStroke)" y1="@YForString(0)" x2="@(GetTimeSignatureAllocatedSpace() + StringStroke)" y2="@YForString(StringCount - 1)"
          stroke="@StringColor" stroke-width="@StringStroke" stroke-linecap="round" />

    <line x1="@_innerWidth" y1="@YForString(0)" x2="@_innerWidth" y2="@YForString(StringCount - 1)"
          stroke="@StringColor" stroke-width="@StringStroke" stroke-linecap="round" />

    <g class="notes" style="font-family: Arial, Helvetica, sans-serif; font-weight: 700; pointer-events: none;">
        @foreach (var note in _noteMarkers)
        {
            var x = NoteXCoordinate(note.Position);

            // note.StringIndex 0 = top string; convert to y
            var y = YForString(note.StringIndex);
            <g class="note" transform="translate(@x, @y)">

                <!-- optional fret circle -->
                <circle cx="0" cy="0" r="@GetCircleRadius()" fill="@_noteFill" stroke="none" stroke-width="1.4" />

                <!-- fret number -->
                <text x="0" y="0" dominant-baseline="central" text-anchor="middle" font-size="@FretNumberSize">
                    @note.Fret
                </text>
            </g>
        }
    </g>
</svg>


