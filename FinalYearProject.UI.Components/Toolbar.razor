@using FinalYearProject.UI.Components.InterfaceElements.Recording
@using FinalYearProject.UI.Components.InterfaceElements.ToolbarWidgets

<div class="toolbar @GetExpanded()">

    <div class="toolbar-header">
        <div class="toggle-switch @GetExpanded()" @onclick="ToggleExpand">
            <img src="/images/expansion/@GetIcon()" class="center">
        </div>
    </div>
    <div class="toolbar-body @GetExpanded()">

        @* Playback Section *@
        <div class="toolbar-section">
            <div class="toolbar-title">
                <span>Playback</span>
            </div>

            <PlayButton NotifyParentOfChange="PlaybackStateChanged" />

            <PauseButton NotifyParentOfChange="PlaybackStateChanged" />

            <StopButton NotifyParentOfChange="PlaybackStateChanged" />

            <BpmWidget NotifyParentOfChange="PlaybackStateChanged" />
        </div>

        @* Audio Section *@
        <div class="toolbar-section @GetExpanded()">
            <div class="toolbar-title">
                <span>Audio</span>
            </div>

            <ToggleUserInputButton />

            <ToggleMetronomeButton />

            <ToggleBackingTrackButton />

            <ToggleMonitoring />

        </div> 
    </div>
</div>
